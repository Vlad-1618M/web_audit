# DMG Finder window layout — 1× points (window 660×440).
# Background PNG is 2× (1320×880) at 144 DPI (required — 72 DPI doubles the logical size and crops).
# Regenerate: python3 generate-dmg-background.py
export DMG_WIN_W=660
export DMG_WIN_H=440
export DMG_ICON_SIZE=128
export DMG_APP_X=168
export DMG_APP_Y=170
export DMG_APPS_X=492
export DMG_APPS_Y=170
# Bottom-left — keeps center clear for drag / first-launch hints.
export DMG_INSTALL_X=88
export DMG_INSTALL_Y=290
